# 只写在服务端。不要加 NEXT_PUBLIC_ 前缀，否则会进浏览器。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 每个访问来源每小时最多复盘次数（上线后保护共用 Key）
REVIEW_RATE_LIMIT_PER_HOUR=8

